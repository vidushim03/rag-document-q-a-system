# Copy this file to .env and fill in your own keys.
# NEVER commit real keys in .env — it is gitignored.

# Required: get a key at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Optional: limit pages processed by OCR (default 5)
MAX_OCR_PAGES=5

# Optional: vision model used for Groq OCR (default qwen/qwen3.6-27b)
GROQ_OCR_MODEL=qwen/qwen3.6-27b

# Qdrant storage. Leave QDRANT_URL blank to use local on-disk storage.
QDRANT_PATH=knowledge_base
QDRANT_URL=
QDRANT_API_KEY=

# Optional local OCR paths on Windows (leave blank to use Groq OCR fallback)
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
POPPLER_PATH=C:\path\to\poppler\Library\bin

# Optional: web search fallback, get a key at https://app.tavily.com
TAVILY_API_KEY=your_tavily_api_key_here
