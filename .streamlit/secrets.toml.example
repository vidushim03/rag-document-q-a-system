# Template for Streamlit Community Cloud secrets.
# In the deploy dialog, paste this into "Advanced settings > Secrets".
# Secrets are injected as environment variables, so the app reads them with os.getenv.

GROQ_API_KEY = "your_groq_api_key_here"
TAVILY_API_KEY = "your_tavily_api_key_here"

# Qdrant Cloud cluster (https://cloud.qdrant.io). Required on Streamlit Cloud
# because the cloud filesystem is ephemeral and cannot host local storage.
QDRANT_URL = "https://your-cluster-id.aws.cloud.qdrant.io:6333"
QDRANT_API_KEY = "your_qdrant_api_key_here"

MAX_OCR_PAGES = "10"
GROQ_OCR_MODEL = "qwen/qwen3.6-27b"
